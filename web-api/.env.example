PORT=3001
DATABASE_URL=postgres://autopilot:autopilot_dev@127.0.0.1:5432/autopilot
# At least 32 random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-characters
JWT_EXPIRES_IN=8h
DASHBOARD_ORIGIN=http://localhost:5173
# How many reverse proxies are in front of this server (0 when none)
TRUST_PROXY_HOPS=0
# open: anyone can sign up (needs the limits below). invite: only with an invite code. closed: nobody.
SIGNUP_MODE=open
# Limits that protect the free model quota when signup is open
MAX_USERS=200
NEW_USER_DAILY_LIMIT=50
NEW_USER_MAX_TOKENS=1024